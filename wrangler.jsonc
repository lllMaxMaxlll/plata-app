{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir EXACTAMENTE con el nombre del Worker en el dashboard de
  // Cloudflare: OpenNext crea un service binding WORKER_SELF_REFERENCE contra
  // este nombre y el deploy falla con 10143 si no existe.
  "name": "plata-app",
  "main": "worker.mjs",
  "triggers": { "crons": ["*/5 * * * *"] },
  // En desarrollo se emula localmente; producción usa este namespace.
  "kv_namespaces": [{ "binding": "MARKET_MONITOR", "id": "967d463b02374299bb3c2d0050976fd8" }],
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers AI: la categorización automática de movimientos corre acá, sin API
  // key propia y facturada por neurons contra la cuenta del Worker.
  "ai": {
    "binding": "AI",
    // Workers AI no tiene emulación local: en `next dev` siempre llama a
    // Cloudflare. Declararlo explícito apaga el aviso de wrangler en cada
    // arranque; en el deploy no cambia nada.
    "remote": true
  },
  // Índice de embeddings para la búsqueda semántica del historial. Hay que
  // crearlo una sola vez con la CLI (ver README): el binding solo no lo crea.
  //
  // `wrangler vectorize create` agrega por su cuenta un binding llamado
  // VECTORIZE contra el mismo índice. Se borra: el código lee TRANSACTIONS_INDEX
  // y dejar los dos sólo deja config muerta que confunde más adelante.
  "vectorize": [
    {
      "binding": "TRANSACTIONS_INDEX",
      "index_name": "plata-transactions",
      // Vectorize no tiene emulación local: sin esto, en `next dev` el binding
      // existe pero falla con "needs to be run remotely". En el deploy no
      // cambia nada, el binding siempre es el real.
      "remote": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
