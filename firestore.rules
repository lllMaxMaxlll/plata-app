rules_version = '2';

// PLATA — every document lives under /users/{userId}.
//
// Two guarantees:
//  1. A user can only reach their own subtree.
//  2. Writes are shape-checked, so a client that skips the app UI cannot store a
//     string balance, a negative amount or an unknown currency and silently break
//     every total, chart and export downstream.
//
// Collections are matched explicitly on purpose: a `{document=**}` catch-all would
// be OR'ed with these rules and grant back everything they reject. Adding a new
// collection to the app means adding its match block here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The document as it will exist after the write (already merged for set/merge)
    function data() {
      return request.resource.data;
    }

    function isCurrency(value) {
      return value in ['ARS', 'USD'];
    }

    function isLabel(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function isPositive(value) {
      return value is number && value > 0;
    }

    function isNonNegative(value) {
      return value is number && value >= 0;
    }

    // Optional field: absent, null, or a number
    function optionalNumber(field) {
      return !(field in data()) || data()[field] == null || data()[field] is number;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /accounts/{accountId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isLabel(data().name)
          && isCurrency(data().currency)
          && data().balance is number
          && data().kind in ['bank', 'wallet', 'cash', 'crypto', 'savings'];
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && data().type in ['income', 'expense', 'transfer']
          && isPositive(data().amount)
          && data().accountId is string
          && data().category is string
          && data().date is string
          && (!('currency' in data()) || data().currency == null || isCurrency(data().currency))
          && (!('toAccountId' in data()) || data().toAccountId == null || data().toAccountId is string)
          && (!('toAmount' in data()) || data().toAmount == null || isPositive(data().toAmount))
          && optionalNumber('exchangeRate');
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isLabel(data().name)
          && data().type in ['income', 'expense']
          && data().color is string;
      }

      match /dueItems/{dueItemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isLabel(data().title)
          && isNonNegative(data().amount)
          && isCurrency(data().currency)
          && data().dueDate is string
          && data().frequency in ['monthly', 'yearly', 'biweekly', 'one_time']
          && data().status in ['pending', 'paid'];
      }

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isLabel(data().name)
          && data().type in ['motorcycle', 'car', 'truck', 'other']
          && isNonNegative(data().odometer);
      }

      match /vehicleLogs/{vehicleLogId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && data().vehicleId is string
          && data().type in ['fuel', 'service', 'part', 'gear', 'insurance', 'other']
          && isNonNegative(data().amount)
          && isNonNegative(data().odometer)
          && data().date is string;
      }

      match /stockTransactions/{stockTransactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && data().symbol is string
          && data().type in ['buy', 'sell']
          && isPositive(data().shares)
          && isPositive(data().price)
          && data().date is string
          && data().accountId is string;
      }

      match /stockPositions/{symbol} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && data().symbol is string
          && isNonNegative(data().shares);
      }

      match /watchlist/{symbol} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && data().symbol is string
          && data().name is string;
      }

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && optionalNumber('exchangeRate')
          && optionalNumber('annualInflation')
          && optionalNumber('annualDevaluation')
          && optionalNumber('annualReturn');
      }

      match /fcmTokens/{token} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && data().token is string;
      }
    }
  }
}
