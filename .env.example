# PLATA — variables de entorno
#
# Regla para decidir dónde va cada una: si el valor lo necesita el navegador,
# lleva el prefijo NEXT_PUBLIC_ y queda incrustado en el bundle, a la vista de
# cualquiera. Si le da poderes que el navegador no debería tener, no lleva el
# prefijo y nunca se despliega en una app cliente.

# ---------------------------------------------------------------------------
# Supabase — lo que usa la app. Ambas son públicas por diseño: la seguridad la
# dan las RLS, no el secreto de la clave.
# En Vercel: marcar como "Config", no como "Sensitive".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Sólo para instancias que todavía emiten la clave con el formato viejo; si
# PUBLISHABLE_KEY está cargada, esta se ignora.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Supabase — SÓLO LOCAL. Saltean las RLS por completo: jamás en el deploy.
# Sirven para aplicar migraciones y para los scripts de migración de datos.
# ---------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Rutas de /api — se leen en el servidor, sin prefijo NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# PLATA AI. Sin esto el asesor sólo funciona si el usuario pone su propia clave.
OPENROUTER_API_KEY=""
# Cotizaciones. Sin esto se cae al fallback de Yahoo, que anda con menos precisión.
FINNHUB_API_KEY=""

# ---------------------------------------------------------------------------
# Notificaciones push — siguen en Firebase Cloud Messaging.
# Son claves de cliente, públicas por diseño.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# Firebase Console > Cloud Messaging > Web Push certificates.
# SIN ESTA, LAS NOTIFICACIONES NO FUNCIONAN. Hoy está vacía.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ---------------------------------------------------------------------------
# Opcionales — tienen valores por defecto razonables en el código
# ---------------------------------------------------------------------------
# Modelos permitidos cuando se usa la clave del servidor (default: openrouter/free)
OPENROUTER_ALLOWED_MODELS=""
# Supuestos de las proyecciones, en % anual (defaults: 45 / 40 / 12)
ANNUAL_INFLATION_RATE=""
ANNUAL_DEVALUATION_RATE=""
ANNUAL_INVESTMENT_RETURN_RATE=""

# ---------------------------------------------------------------------------
# Migración de datos — sólo para scripts/, no lo necesita la app
# ---------------------------------------------------------------------------
# Ruta al JSON de la service account de Firebase, para exportar de Firestore
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ---------------------------------------------------------------------------
# Sin uso — ningún archivo del proyecto lee esta variable. Quedó de cuando el
# asesor usaba Gemini; hoy usa OpenRouter. Se puede borrar.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
